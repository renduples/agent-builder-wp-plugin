# Files and folders excluded from the WordPress.org submission zip.
# Used by bin/export-wporg-tree.sh (and `wp dist-archive` if available).

.git
.github
.gitignore
.distignore
bin

# AI coding-tool directories — untracked, but rsync copies the raw working
# tree so anything present on disk at build time ships unless listed here.
.claude
.cursor
.windsurf
.continue
.aider.chat.history.md
.aider.tags.cache.v4
.DS_Store
._*
.phpunit.result.cache
.fleet-task
.env.local
node_modules
vendor
tests
screenshots
.wordpress-org
reports
CLAUDE.md
Claude.md
SUBMISSION-NOTES.md
.phpcs.xml
phpcs.xml
phpcs.xml.dist
phpunit.xml
phpunit.xml.dist
composer.lock
composer.phar
package-lock.json

# Unused Chart.js copy (never enqueued).
assets/js/chart.js
assets/js/chart.min.js

# WP.org edition is English-only. Keep the POT (translate.wordpress.org
# source template) and language-neutral files (e.g. index.php); drop
# bundled locales. Source .po/.mo/.json stay in git for Pro.
languages/*.po
languages/*.mo
languages/*.json
