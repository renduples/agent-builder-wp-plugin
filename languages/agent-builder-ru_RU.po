#| msgid "When an assistant wants to change something important, it waits here until you approve or reject it."
msgid "When an agent wants to change something important, it waits here until you approve or reject it."
msgstr "Когда агент хочет изменить что-то важное, он ждёт здесь, пока вы не подтвердите или не отклоните действие."

#: includes/class-admin-pages-rest.php:964
#| msgid "Approvals keep high-risk assistant actions under human control. Email alerts use your admin address and never include passwords. See Privacy Policy for how providers process chat."
msgid "Approvals keep high-risk agent actions under human control. Email alerts use your admin address and never include passwords. See Privacy Policy for how providers process chat."
msgstr "Подтверждения оставляют действия агентов с высоким риском под контролем человека. Оповещения на email отправляются на ваш адрес администратора и никогда не содержат паролей. О том, как провайдеры обрабатывают чат, см. в Политике конфиденциальности."

#: includes/class-admin-pages-rest.php:982
msgid "Always ask me"
msgstr "Всегда спрашивать меня"

#: includes/class-admin-pages-rest.php:983
msgid "Safest default"
msgstr "Самый безопасный вариант по умолчанию"

#: includes/class-admin-pages-rest.php:984
msgid "Important or writing actions wait for you. Best when you want full control."
msgstr "Важные действия и действия с записью текста ждут вас. Лучший вариант, если нужен полный контроль."

#: includes/class-admin-pages-rest.php:985
msgid "No automatic approvals beyond the safest reads."
msgstr "Никаких автоматических подтверждений, кроме самых безопасных операций чтения."

#: includes/class-admin-pages-rest.php:993
msgid "Auto-approve low risk"
msgstr "Автоматически подтверждать низкий риск"

#: includes/class-admin-pages-rest.php:994
msgid "Recommended for most sites"
msgstr "Рекомендуется для большинства сайтов"

#: includes/class-admin-pages-rest.php:995
msgid "Simple look-ups run freely. Drafts and bigger changes still pause for confirmation or this queue."
msgstr "Простые запросы выполняются свободно. Черновики и более серьёзные изменения по-прежнему требуют подтверждения или ожидают в этой очереди."

#: includes/class-admin-pages-rest.php:996
msgid "You accept that low-risk tools may run without a separate approval email."
msgstr "Вы соглашаетесь с тем, что инструменты с низким риском могут выполняться без отдельного письма с подтверждением."

#: includes/class-admin-pages-rest.php:1004
msgid "Trust more (higher risk)"
msgstr "Больше доверия (выше риск)"

#: includes/class-admin-pages-rest.php:1005
msgid "Faster — use with care"
msgstr "Быстрее — используйте с осторожностью"

#: includes/class-admin-pages-rest.php:1006
