#: admin/agents.php:31 agent-builder.php:436 src/settings-app/index.js:1075
msgid "AI Agents"
msgstr "ИИ-агенты"

#: admin/agents.php:36
msgid "Enable Automatic Agent Updates?"
msgstr "Включить автоматические обновления агентов?"

#: admin/agents.php:37
msgid "Agent Builder can check agentic-plugin.com for newer versions of your installed AI agents."
msgstr "Agent Builder может проверять на agentic-plugin.com наличие новых версий установленных ИИ-агентов."

#: admin/agents.php:43
msgid "Security patches delivered fast"
msgstr "Быстрая доставка исправлений безопасности"

#: admin/agents.php:44
msgid "Agent vulnerabilities can be exploited silently. Updates close those gaps before bad actors find them."
msgstr "Уязвимости агентов могут использоваться незаметно. Обновления закрывают эти бреши до того, как их найдут злоумышленники."

#: admin/agents.php:48
msgid "Better agent performance"
msgstr "Более высокая производительность агентов"

#: admin/agents.php:49
msgid "Agent logic, prompts, and tool integrations are continuously improved. Updates mean your agents work smarter."
msgstr "Логика агентов, промпты и интеграции инструментов постоянно улучшаются. Обновления делают ваших агентов умнее."

#: admin/agents.php:53
msgid "You stay in control"
msgstr "Вы сохраняете контроль"

#: admin/agents.php:54
msgid "Updates are never applied automatically — you review and install each one yourself, exactly like WordPress plugins."
msgstr "Обновления никогда не применяются автоматически — вы сами просматриваете и устанавливаете каждое из них, точно так же, как плагины WordPress."

#. translators: %1$s: agentic-plugin.com URL, %2$s: Privacy Policy URL
#: admin/agents.php:63
#, php-format
msgid "When enabled, your installed agent slugs and version numbers are sent to <a href=\"%1$s\" target=\"_blank\" rel=\"noopener\">agentic-plugin.com</a> to check for updates. No personal data, passwords, or site content are included. See our <a href=\"%2$s\" target=\"_blank\" rel=\"noopener\">Privacy Policy</a>."
msgstr "Когда эта функция включена, слаги и номера версий установленных агентов отправляются на <a href=\"%1$s\" target=\"_blank\" rel=\"noopener\">agentic-plugin.com</a> для проверки обновлений. Личные данные, пароли и содержимое сайта не передаются. См. нашу <a href=\"%2$s\" target=\"_blank\" rel=\"noopener\">Политику конфиденциальности</a>."

#: admin/agents.php:81
msgid "Enable Agent Updates"
msgstr "Включить обновления агентов"

#: admin/agents.php:84
msgid "No Thanks"
msgstr "Нет, спасибо"

