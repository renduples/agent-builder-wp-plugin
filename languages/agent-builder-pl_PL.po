#: admin/agents.php:31 agent-builder.php:436 src/settings-app/index.js:1075
msgid "AI Agents"
msgstr "Agenci AI"

#: admin/agents.php:36
msgid "Enable Automatic Agent Updates?"
msgstr "Włączyć automatyczne aktualizacje agentów?"

#: admin/agents.php:37
msgid "Agent Builder can check agentic-plugin.com for newer versions of your installed AI agents."
msgstr "Agent Builder może sprawdzać w serwisie agentic-plugin.com, czy dostępne są nowsze wersje zainstalowanych agentów AI."

#: admin/agents.php:43
msgid "Security patches delivered fast"
msgstr "Szybko dostarczane poprawki bezpieczeństwa"

#: admin/agents.php:44
msgid "Agent vulnerabilities can be exploited silently. Updates close those gaps before bad actors find them."
msgstr "Podatności agentów mogą zostać wykorzystane niepostrzeżenie. Aktualizacje zamykają te luki, zanim znajdą je osoby o złych zamiarach."

#: admin/agents.php:48
msgid "Better agent performance"
msgstr "Lepsza wydajność agentów"

#: admin/agents.php:49
msgid "Agent logic, prompts, and tool integrations are continuously improved. Updates mean your agents work smarter."
msgstr "Logika agentów, prompty i integracje z narzędziami są stale ulepszane. Aktualizacje sprawiają, że agenci działają sprawniej."

#: admin/agents.php:53
msgid "You stay in control"
msgstr "Zachowujesz kontrolę"

#: admin/agents.php:54
msgid "Updates are never applied automatically — you review and install each one yourself, exactly like WordPress plugins."
msgstr "Aktualizacje nigdy nie są instalowane automatycznie — każdą z nich przeglądasz i instalujesz samodzielnie, dokładnie tak jak wtyczki WordPressa."

#. translators: %1$s: agentic-plugin.com URL, %2$s: Privacy Policy URL
#: admin/agents.php:63
#, php-format
msgid "When enabled, your installed agent slugs and version numbers are sent to <a href=\"%1$s\" target=\"_blank\" rel=\"noopener\">agentic-plugin.com</a> to check for updates. No personal data, passwords, or site content are included. See our <a href=\"%2$s\" target=\"_blank\" rel=\"noopener\">Privacy Policy</a>."
msgstr "Po włączeniu tej opcji uproszczone nazwy (slugi) i numery wersji zainstalowanych agentów są wysyłane do <a href=\"%1$s\" target=\"_blank\" rel=\"noopener\">agentic-plugin.com</a> w celu sprawdzenia aktualizacji. Nie są przesyłane żadne dane osobowe, hasła ani treści witryny. Zobacz naszą <a href=\"%2$s\" target=\"_blank\" rel=\"noopener\">Politykę prywatności</a>."

#: admin/agents.php:81
msgid "Enable Agent Updates"
msgstr "Włącz aktualizacje agentów"

#: admin/agents.php:84
msgid "No Thanks"
msgstr "Nie, dziękuję"

